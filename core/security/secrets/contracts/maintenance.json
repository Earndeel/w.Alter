{
  "version": 1,
  "module": "secrets",
  "check": [
    "python3",
    "/walter/core/security/secrets/guardian/check"
  ],
  "max_level": "G1",
  "levels": {
    "G0": "session partagée, santé des autorisations",
    "G1": "renouveler un jeton OAuth"
  },
  "note": "Métadonnées seulement ; jamais `bw unlock` directement (session partagée).",
  "format": "incident-v1",
  "timeout_seconds": 240,
  "guardian": [
    "walter-guardian",
    "run",
    "--module",
    "secrets"
  ]
}
