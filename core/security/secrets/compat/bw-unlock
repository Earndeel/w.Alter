#!/usr/bin/env bash
# bw-unlock — former shell helper (2026-06). One implementation now: walter-secrets' own bw-unlock (exclusive lock
# while unlocking, renewal of a refused session). Same usages as before:
#   source ~/.hermes/bin/bw-unlock      → exports BW_SESSION
#   ~/.hermes/bin/bw-unlock --print     → prints the session ;  --check → status
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    BW_SESSION="$(walter-secret-unlock --print 2>/dev/null | tail -1)"; export BW_SESSION; return 0
fi
exec walter-secret-unlock "${@:---print}"
