def edit_vault():
    """Decrypt, open in editor, re-encrypt."""
    vault = decrypt_vault()
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False, prefix='vault_') as f:
        json.dump(vault, f, indent=2)
        tmp_path = f.name

    editor = os.environ.get('EDITOR', 'nano')
    subprocess.run([editor, tmp_path])

    with open(tmp_path, 'r') as f:
        new_vault = json.load(f)
    os.unlink(tmp_path)

    encrypt_vault(new_vault)
    print("✓ Vault edited and re-encrypted.")


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(0)

    cmd = sys.argv[1]

    if cmd == "get" and len(sys.argv) == 3:
        get_field(sys.argv[2])
    elif cmd == "list":
        show_secrets = "--secrets" in sys.argv
        list_services(show_secrets)
    elif cmd == "add" and len(sys.argv) >= 5:
        add_field(sys.argv[2], sys.argv[3], " ".join(sys.argv[4:]))
    elif cmd == "remove" and len(sys.argv) == 4:
        remove_field(sys.argv[2], sys.argv[3])
    elif cmd == "rotate" and len(sys.argv) >= 5:
        add_field(sys.argv[2], sys.argv[3], " ".join(sys.argv[4:]))
    elif cmd == "search" and len(sys.argv) == 3:
        search_vault(sys.argv[2])
    elif cmd == "export":
        if "--mcporter" in sys.argv:
            export_mcporter()
        else:
            export_env()
    elif cmd == "import-env":
        import_env()
    elif cmd == "encrypt":
        encrypt_vault()
    elif cmd == "decrypt":
        vault = decrypt_vault()
        print(json.dumps(vault, indent=2))
    elif cmd == "edit":
        edit_vault()
    else:
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    main()
