#!/usr/bin/env python3
"""
W.Alter Vault — Centralized credential management with age encryption.

Usage:
  vault get <service>/<field>        Get a specific value
  vault list [--secrets]             List all services (use --secrets to show values)
  vault add <service> <field> <val>  Add or update a key
  vault remove <service> <field>     Remove a key
  vault search <query>               Search services/fields
  vault rotate <service> <field> <val>  Alias for add (key rotation)
  vault export [--env|--mcporter]    Export to .env or mcporter.json
  vault import-env                   Import keys from current .env
  vault encrypt                      Re-encrypt after manual edits
  vault decrypt                      Decrypt vault.json (for debugging)
  vault edit                         Open vault.json in $EDITOR (decrypts, opens, re-encrypts)
"""

import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

def _instance_vault() -> Path:
    """The instance's bootstrap vault (`walter instance path`), not Hermes' home (E9.8)."""
    try:
        root = subprocess.run(["walter", "instance", "path"], capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        root = ""
    return Path(root) / "bootstrap" / "vault" if root else Path.home() / ".hermes" / "vault"


VAULT_DIR = _instance_vault()
VAULT_JSON = VAULT_DIR / "vault.json"
VAULT_ENC = VAULT_DIR / "vault.json.age"
KEY_FILE = VAULT_DIR / "age-key.txt"
ENV_FILE = Path.home() / ".hermes" / ".env"
MCPORTER_FILE = Path.home() / ".hermes" / "mcp" / "mcporter.json"

PUBLIC_KEY = "age1r0hjrlt7gtr4euyc643agayjzzft4hy3d6zzd8lqe4acl85h39lsvn6u9g"


def decrypt_vault() -> dict:
    """Decrypt vault.json.age and return parsed JSON."""
    if not VAULT_ENC.exists():
        print("Error: vault.json.age not found. Run 'vault import-env' first.", file=sys.stderr)
        sys.exit(1)
    result = subprocess.run(
        ["age", "-d", "-i", str(KEY_FILE), str(VAULT_ENC)],
        capture_output=True, text=True
    )
    if result.returncode != 0:
        print(f"Error decrypting vault: {result.stderr}", file=sys.stderr)
        sys.exit(1)
    return json.loads(result.stdout)


def encrypt_vault(vault: dict = None):
    """Encrypt vault.json to vault.json.age."""
    if vault is not None:
        with open(VAULT_JSON, 'w') as f:
            json.dump(vault, f, indent=2)
    if not VAULT_JSON.exists():
        print("Error: vault.json not found.", file=sys.stderr)
        sys.exit(1)
    result = subprocess.run(
        ["age", "-r", PUBLIC_KEY, "-o", str(VAULT_ENC), str(VAULT_JSON)],
        capture_output=True, text=True
    )
    if result.returncode != 0:
        print(f"Error encrypting vault: {result.stderr}", file=sys.stderr)
        sys.exit(1)
    # Remove plaintext after encryption
    VAULT_JSON.unlink(missing_ok=True)
    print("✓ Vault encrypted.")


def get_field(path: str) -> str:
    """Get a value by service/field path."""
    vault = decrypt_vault()
    parts = path.split("/", 1)
    if len(parts) != 2:
        print(f"Error: path must be <service>/<field>, got '{path}'", file=sys.stderr)
        sys.exit(1)
    service, field = parts
    if service not in vault.get("services", {}):
        print(f"Error: service '{service}' not found.", file=sys.stderr)
        sys.exit(1)
    if field not in vault["services"][service]:
        print(f"Error: field '{field}' not found in service '{service}'.", file=sys.stderr)
        sys.exit(1)
    print(vault["services"][service][field])


def list_services(show_secrets: bool = False):
    """List all services and their fields."""
    vault = decrypt_vault()
    services = vault.get("services", {})
    for svc_name in sorted(services.keys()):
        svc = services[svc_name]
        category = svc.get("_category", "api")
        print(f"\n📦 {svc_name} [{category}]")
        for field, value in sorted(svc.items()):
            if field.startswith("_"):
                continue
            if show_secrets:
                # Mask middle of value for display
                if len(value) > 12:
                    masked = value[:4] + "..." + value[-4:]
                else:
                    masked = value
                print(f"   {field}: {masked}")
            else:
                print(f"   {field}: {'*' * 8}")

    # Providers
    providers = vault.get("providers", {})
    if providers:
        print(f"\n🔑 Providers: {', '.join(k for k in sorted(providers.keys()) if not k.startswith('_'))}")

    # MCP Servers
    mcp = vault.get("mcp_servers", {})
    if mcp:
        print(f"\n🔌 MCP Servers: {', '.join(sorted(mcp.keys()))}")


def add_field(service: str, field: str, value: str):
    """Add or update a field in a service."""
    vault = decrypt_vault()
    if service not in vault.get("services", {}):
        vault["services"][service] = {"_category": "custom"}
    vault["services"][service][field] = value
    encrypt_vault(vault)
    print(f"✓ Set {service}/{field}")


def remove_field(service: str, field: str):
    """Remove a field from a service."""
    vault = decrypt_vault()
    if service not in vault.get("services", {}):
        print(f"Error: service '{service}' not found.", file=sys.stderr)
        sys.exit(1)
    if field not in vault["services"][service]:
        print(f"Error: field '{field}' not found in service '{service}'.", file=sys.stderr)
        sys.exit(1)
    del vault["services"][service][field]
    # Remove service if empty (only _category left)
    remaining = {k: v for k, v in vault["services"][service].items() if not k.startswith("_")}
    if not remaining:
        del vault["services"][service]
    encrypt_vault(vault)
    print(f"✓ Removed {service}/{field}")


def search_vault(query: str):
    """Search for a query across services and fields."""
    vault = decrypt_vault()
    query_lower = query.lower()
    results = []
    for svc_name, svc in vault.get("services", {}).items():
        if query_lower in svc_name.lower():
            results.append(f"📦 {svc_name} (service name match)")
        for field, value in svc.items():
            if field.startswith("_"):
                continue
            if query_lower in field.lower() or query_lower in svc_name.lower():
                results.append(f"   → {svc_name}/{field}")

    if results:
        print(f"Search results for '{query}':")
        for r in results:
            print(r)
    else:
        print(f"No results for '{query}'.")


