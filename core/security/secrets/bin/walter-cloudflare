#!/usr/bin/env python3
"""walter-cloudflare — run a command with the Cloudflare credentials Walter Secrets grants it (never printed).

  walter-cloudflare check                 verify every credential (no secret shown)
  walter-cloudflare -- <command…>          run <command> with only these variables added to its environment:
      CLOUDFLARE_ACCOUNT_ID  account id                         grant cloudflare-api, attribute account_id
      CLOUDFLARE_EMAIL       account e-mail = login of the key   grant cloudflare-api, attribute email
                              (never take an e-mail from an example in a skill, e.g. user@example.com)
      CLOUDFLARE_API_KEY     GLOBAL API key, all rights          grant cloudflare-api, part global_api_key
      CLOUDFLARE_API_TOKEN   scoped token                        grant cloudflare-api (has NO Workers AI permission)
      CLOUDFLARE_AI_TOKEN    scoped « Workers AI Read » token    grant cloudflare-workers-ai
Targeted injection owned by Walter Secrets (2026-11-11): the values come from Bitwarden through the grants
(instance accounts/cloudflare-*.toml, reader « walter-cloudflare »), never from a file; a missing one fails closed.
Use the global key only for account administration (create tokens, D1, deploy); everything recurring uses a scoped
token. REST: global key -> headers X-Auth-Email + X-Auth-Key ; token -> Authorization: Bearer.
"""
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from walter_secrets import grants  # noqa: E402

READER = "walter-cloudflare"
GRANTS = ["cloudflare-api", "cloudflare-workers-ai"]
API = "https://api.cloudflare.com/client/v4"


def credentials() -> dict:
    return grants.environment(GRANTS, READER)


def _get(path: str, headers: dict) -> str:
    try:
        with urllib.request.urlopen(urllib.request.Request(API + path, headers=headers), timeout=30) as r:
            return "ok" if json.loads(r.read()).get("success") else "refused"
    except urllib.error.HTTPError as exc:
        return f"HTTP {exc.code}"
    except urllib.error.URLError as exc:
        return f"unreachable ({type(exc.reason).__name__})"


def _one(ident: str) -> dict:
    try:
        return grants.environment([ident], READER)
    except Exception as exc:  # noqa: BLE001 — report the grant and the kind of failure, never a storage detail
        print(f"{ident:<22}: unavailable ({type(exc).__name__}: {str(exc)[:120]})")
        return {}


def check() -> int:
    api, ai = _one("cloudflare-api"), _one("cloudflare-workers-ai")
    ok = True
    if api.get("CLOUDFLARE_EMAIL") and api.get("CLOUDFLARE_API_KEY"):
        r = _get("/user", {"X-Auth-Email": api["CLOUDFLARE_EMAIL"], "X-Auth-Key": api["CLOUDFLARE_API_KEY"]})
        print("global key + e-mail :", r); ok &= r == "ok"
    if api.get("CLOUDFLARE_API_TOKEN"):
        r = _get("/user/tokens/verify", {"Authorization": f'Bearer {api["CLOUDFLARE_API_TOKEN"]}'})
        print("api token           :", r); ok &= r == "ok"
    if ai.get("CLOUDFLARE_AI_TOKEN"):
        r = _get("/user/tokens/verify", {"Authorization": f'Bearer {ai["CLOUDFLARE_AI_TOKEN"]}'})
        print("Workers AI token    :", r); ok &= r == "ok"
    account = api.get("CLOUDFLARE_ACCOUNT_ID") or ai.get("CLOUDFLARE_ACCOUNT_ID") or ""
    print("account id          :", "set" if len(account) == 32 else "missing")
    ok &= bool(api) and bool(ai) and len(account) == 32
    return 0 if ok else 1


def main(argv: list) -> int:
    if argv[:1] == ["check"]:
        return check()
    if argv[:1] == ["--"] and len(argv) > 1:
        try:
            env = {**os.environ, **credentials()}
        except Exception as exc:  # noqa: BLE001
            raise SystemExit(f"walter-cloudflare: credentials unavailable ({type(exc).__name__}: {str(exc)[:160]})")
        os.execvpe(argv[1], argv[1:], env)
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
