#!/usr/bin/env python3
"""walter-soul — the agent's identity, rendered for every runtime of the active instance.

Software (this module, identical for every instance): the renderer, runtime adapters (runtimes/*.md: tool names,
write rules), default identity and rules for a new instance (defaults/), default targets (config/targets.toml).
Instance (found with `walter instance`): identity.md and rules.md (its own git, whose post-commit hook runs
`sync`), optional per-runtime additions, the user profile, target overrides (config/soul/targets.toml), state.

Placeholders such as {{owner.address}} are filled by `walter instance render`; {{include profile}} inserts the
curated user profile. Targets are generated, one-way. A target edited by hand since the last sync is never
overwritten silently: sync refuses it (exit 2) and keeps a copy in the instance's drift folder; port the change
into the sources, then `sync --force`.

Usage: walter-soul render <target> | path <target> | sync [--force] | check | init
"""
from __future__ import annotations

import hashlib
import re
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PARTS = {  # instance sources (identity, rules) + shipped runtime adapters, in order
    "hermes": ["identity", "rules", "hermes"],
    "claude-code": ["identity", "rules", "agent-cli", "claude-code"],
    "codex": ["identity", "rules", "agent-cli", "codex"],
    "dsh": ["identity", "rules", "agent-cli", "dsh"],
    "agent": ["identity", "rules"],
}
INCLUDE = re.compile(r"^\{\{include (\S+)\}\}$", re.M)
INSTANCE = "@instance"


def _walter(*args: str, stdin: str | None = None) -> str:
    r = subprocess.run(["walter", "instance", *args], input=stdin, capture_output=True, text=True, timeout=30)
    if r.returncode:
        raise SystemExit(f"walter instance {' '.join(args)} failed: {r.stdout.strip() or r.stderr.strip()}")
    return r.stdout


def _merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for k, v in over.items():
        out[k] = _merge(out[k], v) if isinstance(v, dict) and isinstance(out.get(k), dict) else v
    return out


def _sha(text: str) -> str:
    return hashlib.sha256(text.encode()).hexdigest()


class Soul:
    def __init__(self) -> None:
        self.instance = Path(_walter("path").strip())
        conf = tomllib.loads((ROOT / "config" / "targets.toml").read_text())
        override = self.instance / "config" / "soul" / "targets.toml"
        if override.is_file():
            conf = _merge(conf, tomllib.loads(override.read_text()))
        self.sources = {k: self._path(v) for k, v in conf["sources"].items()}
        self.targets = {k: self._path(v) for k, v in conf["targets"].items() if k in PARTS}

    def _path(self, value: str) -> Path:
        p = self.instance / value[len(INSTANCE):].lstrip("/") if (
            value == INSTANCE or value.startswith(INSTANCE + "/")) else Path(value)
        if not p.is_absolute() or ".." in p.parts:
            raise SystemExit(f"unsafe soul path: {value}")
        return p

    def _part(self, name: str) -> str:
        if name in ("identity", "rules"):
            return self.sources[name].read_text().strip()
        text = (ROOT / "runtimes" / f"{name}.md").read_text().strip()
        extra = self.sources["runtimes"] / f"{name}.md"
        return text + ("\n" + extra.read_text().strip() if extra.is_file() else "")

    def _include(self, m: re.Match) -> str:
        p = self.sources.get(m.group(1)) or self._path(m.group(1))
        try:
            return p.read_text(errors="replace").strip()
        except OSError as e:
            return f"(indisponible : {e.strerror})"

    def render(self, target: str) -> str:
        body = "\n\n".join(INCLUDE.sub(self._include, self._part(p)) for p in PARTS[target])
        text = (f"<!-- GÉNÉRÉ par walter-soul ({target}) — ne pas éditer ici : sources dans "
                f"{self.sources['identity'].parent} -->\n# W.Alter\n\n{body}\n")
        return _walter("render", stdin=text)

    def status(self, target: str) -> tuple[str, str]:
        """→ (state, rendered). state: ok | stale (sources changed) | drift (edited by hand) | missing | new."""
        out = self.targets[target]
        new = self.render(target)
        if not out.exists():
            return "missing", new
        cur = out.read_text(errors="replace")
        if cur == new:
            return "ok", new
        last = self.sources["state"] / f"{target}.sha256"
        if not last.exists():
            return "new", new  # never synced: the current file predates walter-soul
        return ("stale" if _sha(cur) == last.read_text().strip() else "drift"), new


def sync(soul: Soul, force: bool) -> int:
    state, drift = soul.sources["state"], soul.sources["drift"]
    state.mkdir(parents=True, exist_ok=True)
    rc = 0
    for target, out in soul.targets.items():
        st, new = soul.status(target)
        if st == "ok":
            print(f"{target:12} ok")
            continue
        if st in ("new", "drift"):  # keep what was there before writing over it
            drift.mkdir(parents=True, exist_ok=True)
            keep = drift / f"{target}-{time.strftime('%Y%m%d-%H%M%S')}-{out.name}"
            shutil.copy2(out, keep)
            if st == "drift" and not force:
                print(f"{target:12} DRIFT: {out} edited by hand (copy: {keep}); port it into the sources, then sync --force")
                rc = 2
                continue
        out.parent.mkdir(parents=True, exist_ok=True)
        tmp = out.with_name(out.name + ".tmp")
        tmp.write_text(new)
        tmp.replace(out)
        (state / f"{target}.sha256").write_text(_sha(new))
        print(f"{target:12} written ({st}) → {out}")
    return rc


def check(soul: Soul) -> int:
    bad = 0
    for target in soul.targets:
        st, _ = soul.status(target)
        print(f"{target:12} {st}")
        bad |= st != "ok"
    return 1 if bad else 0


def init(soul: Soul) -> int:
    """Seed a new instance with the shipped default identity and rules (never overwrites)."""
    for name in ("identity", "rules"):
        dest = soul.sources[name]
        if dest.exists():
            print(f"{name:12} kept {dest}")
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(ROOT / "defaults" / f"{name}.md", dest)
        print(f"{name:12} seeded {dest}")
    return 0


def main(argv: list[str]) -> int:
    if len(argv) >= 2 and argv[0] in ("render", "path") and argv[1] in PARTS:
        soul = Soul()
        if argv[0] == "path":
            print(soul.targets[argv[1]])
        else:
            sys.stdout.write(soul.render(argv[1]))
        return 0
    if argv[:1] == ["sync"]:
        return sync(Soul(), "--force" in argv)
    if argv[:1] == ["check"]:
        return check(Soul())
    if argv[:1] == ["init"]:
        return init(Soul())
    print(__doc__, file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
