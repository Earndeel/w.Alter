#!/bin/bash
# Walter Router 48 h cycle:
#   1. research + analysis: every source fetched by the router itself (research/), understood and organised in the
#      database, models ranked, active library written (analysis/); no message yet
#   2. research agent on the ECONOMIC text tier (L1, read from the router: today GPT-6 Luna max via Codex): checks
#      names on the web (validated alias-add), watches the subscription plans; report only
#   3. analysis again with the new name links, then Telegram (only news worth it: a model above an active one…)
#   4. Hermes auxiliary jobs follow the postes; interface: the library page is republished
# A failing source keeps its last good snapshot; step 2 never blocks the cycle.
# Instance bindings (Hermes home, log folder, rendered agent prompt, library URL) come from the active Walter
# instance through `walter-router instance-env`.
set -uo pipefail
WR=walter-router
export HOME="${HOME:-$(getent passwd "$(id -un)" | cut -d: -f6)}"
eval "$("$WR" instance-env)" || { echo "[cycle] no instance bindings"; exit 1; }
export HERMES_HOME
HPY="$HERMES_HOME/hermes-agent/venv/bin/python"
HERMES="$HERMES_HOME/hermes-agent/venv/bin/hermes"
mkdir -p "$LOG"
day=$(date -u +%Y%m%d)

echo "[cycle] 1/4 research + analysis (no message yet)"
"$WR" refresh --no-notify || exit 1   # a failed refresh fails the unit (Telegram only after 2 failed cycles)

echo "[cycle] 2/4 research agent on the economic tier (names on the web, subscription watch)"
route=$("$WR" pick general --level L1) || route='{}' 
read -r PROVIDER MODEL REASONING < <(printf '%s' "$route" | "$HPY" -c '
import json, sys
d = json.load(sys.stdin)
r = next((e for e in d.get("execution", []) if e.get("probe_ok") is not False), None)
print(r["hermes_provider"], r["model"], r.get("reasoning") or "") if r else print("", "", "")')
if [ -z "$PROVIDER" ]; then echo "[cycle] no usable L1 route: research agent skipped"; else
args=(chat --query-file "$ANALYSIS_PROMPT" --oneshot -Q --provider "$PROVIDER" -m "$MODEL"
      -t terminal,file,web --max-turns 45 --run-budget 1200 --source walter-router-analysis)
[ -n "$REASONING" ] && args+=(--reasoning "$REASONING")
echo "[cycle] research agent model: $PROVIDER $MODEL ${REASONING:-}"
WALTER_ROUTER_CHILD=1 timeout 1100 "$HERMES" "${args[@]}" > "$LOG/analysis-run-$day.log" 2>&1 \
  || echo "[cycle] research agent failed (exit $?) — see $LOG/analysis-run-$day.log"
fi

echo "[cycle] plans: meters, billing mails, web research on the plans, cost price of a token"
timeout 1500 "$WR" research plans > "$LOG/plans-$day.json" 2>&1 || echo "[cycle] plans research failed (non-blocking)"

echo "[cycle] 3/4 analysis with the new name links, then Telegram (only: a new model above an active one)"
"$WR" refresh --skip-collect || exit 1
echo "[cycle] 4/4 Hermes auxiliary jobs follow the postes (only when a pick changed); library page republished"
"$WR" sync-hermes --apply > "$LOG/sync-hermes-$day.json" 2>&1 || echo "[cycle] sync-hermes failed (non-blocking)"
echo "[cycle] library page ${LIBRARY_URL:-(not published by this instance)} (Cloudflare Access)"
"$WR" publish-library || echo "[cycle] library page not published (non-blocking)"
exit 0
