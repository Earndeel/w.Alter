#!/usr/bin/env python3
"""Manual trigger of the full Walter Router cycle, for the library page button (2026-10-14).

127.0.0.1:8896, reached only through the instance's Cloudflare tunnel host (host.json control_origin), itself behind a
Cloudflare Access app that admits only the Pages project's service token. Every request also carries an HMAC
(X-Walter-Ts, X-Walter-Sig = HMAC-SHA256(secret, ts + method + path), 5-minute window); secret in
the instance's control_env file (0600).
  POST /run     start walter-router-refresh.service (the 48 h cycle) unless it runs or started < 10 min ago
  GET  /status  running?, current step, last start/end, result
  POST /plans   edit the owner's plans from the page: {"action": "set"|"retire", "sub_id", "fields"} (HMAC also covers
                the body: ts + method + path + sha256(body)); applied by `walter-router plans`, page republished
"""
import hashlib
import hmac
import json
import re
import shlex
import subprocess
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

UNIT = "walter-router-refresh.service"
def _control_env() -> Path:
    """The instance's HMAC secret file (host.json control_env), through `walter-router instance-env`."""
    out = subprocess.run(["walter-router", "instance-env"], capture_output=True, text=True, timeout=60, check=True).stdout
    for line in out.splitlines():
        if line.startswith("CONTROL_ENV="):
            return Path(shlex.split(line.split("=", 1)[1])[0])
    raise SystemExit("no control secret for this instance")


ENV = _control_env()
MIN_GAP_S = 600


def secret() -> bytes:
    for line in ENV.read_text().splitlines():
        if line.startswith("CONTROL_SECRET="):
            return line.split("=", 1)[1].strip().encode()
    raise SystemExit("CONTROL_SECRET missing")


def status() -> dict:
    out = subprocess.run(["systemctl", "show", UNIT, "-p", "ActiveState,ExecMainStartTimestamp,ExecMainExitTimestamp,Result"],
                         capture_output=True, text=True).stdout
    p = dict(line.split("=", 1) for line in out.splitlines() if "=" in line)
    step = None
    if p.get("ActiveState") == "activating":
        log = subprocess.run(["journalctl", "-u", UNIT, "--since", "-2h", "-o", "cat", "--no-pager"],
                             capture_output=True, text=True).stdout
        steps = re.findall(r"\[cycle\] (\d)/4|\[cycle\] (library page)", log)
        names = {"1": "1/4 recherche et analyse", "2": "2/4 agent de recherche (modèle économique)",
                 "3": "3/4 analyse finale et notifications", "4": "4/4 Hermes et page", "library page": "publication de la page"}
        step = names.get((steps[-1][0] or steps[-1][1]) if steps else "", "démarrage")
    return {"running": p.get("ActiveState") == "activating", "step": step, "result": p.get("Result"),
            "started": p.get("ExecMainStartTimestamp") or None, "finished": p.get("ExecMainExitTimestamp") or None}


class H(BaseHTTPRequestHandler):
    def _ok(self, code: int, obj: dict) -> None:
        body = json.dumps(obj, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _auth(self, body_digest: str = "") -> bool:
        ts, sig = self.headers.get("X-Walter-Ts", ""), self.headers.get("X-Walter-Sig", "")
        if not ts.isdigit() or abs(time.time() - int(ts)) > 300:
            return False
        want = hmac.new(secret(), f"{ts}{self.command}{self.path}{body_digest}".encode(), hashlib.sha256).hexdigest()
        return hmac.compare_digest(want, sig)

    def do_GET(self):  # noqa: N802
        if self.path != "/status" or not self._auth():
            return self._ok(404, {"error": "not found"})
        self._ok(200, status())

    def _plans(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n <= 0 or n > 4000:
            return self._ok(400, {"error": "bad body"})
        raw = self.rfile.read(n)
        if not self._auth(hashlib.sha256(raw).hexdigest()):
            return self._ok(404, {"error": "not found"})
        try:
            req = json.loads(raw)
            sid = str(req["sub_id"])
            if not re.fullmatch(r"[a-z0-9][a-z0-9-]{1,40}", sid) or req.get("action") not in ("set", "retire"):
                raise ValueError("bad request")
        except (ValueError, KeyError, TypeError):
            return self._ok(400, {"error": "requête invalide (identifiant : lettres minuscules, chiffres, tirets)"})
        cmd = ["walter-router", "plans", "retire" if req["action"] == "retire" else "set", sid, "--why", "modifié depuis la page"]
        f = req.get("fields") or {}
        for key, flag in (("vendor", "--vendor"), ("plan", "--plan"), ("price_usd_month", "--price"), ("note", "--note")):
            if req["action"] == "set" and str(f.get(key) or "").strip():
                cmd += [flag, str(f[key]).strip()[:200]]
        if req["action"] == "set" and f.get("models"):
            cmd += ["--models", ",".join(str(m).strip()[:60] for m in f["models"][:20])]
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        if out.returncode != 0:
            return self._ok(400, {"error": (out.stdout + out.stderr).strip()[-300:]})
        subprocess.Popen(["walter-router", "publish-library"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return self._ok(200, {"message": "Enregistré", "result": json.loads(out.stdout)})

    def do_POST(self):  # noqa: N802
        if self.path == "/plans":
            return self._plans()
        if self.path != "/run" or not self._auth():
            return self._ok(404, {"error": "not found"})
        st = status()
        if st["running"]:
            return self._ok(409, {**st, "message": "Un cycle est déjà en cours."})
        started = subprocess.run(["systemctl", "show", UNIT, "-p", "ExecMainStartTimestampMonotonic", "--value"],
                                 capture_output=True, text=True).stdout.strip()
        uptime = float(Path("/proc/uptime").read_text().split()[0])
        if started and started != "0" and uptime - int(started) / 1e6 < MIN_GAP_S:
            return self._ok(429, {**st, "message": "Un cycle a démarré il y a moins de 10 minutes."})
        subprocess.run(["systemctl", "start", "--no-block", UNIT], check=True)
        time.sleep(1)
        self._ok(202, {**status(), "message": "Cycle complet lancé."})

    def log_message(self, fmt, *args):  # quiet, no headers in logs
        print(f"{self.command} {self.path} -> {args[1] if len(args) > 1 else ''}", flush=True)


if __name__ == "__main__":
    ThreadingHTTPServer(("127.0.0.1", 8896), H).serve_forever()
