[Unit]
Description=walter-context preflight service (127.0.0.1:8897) — the ContextPlan of each owner message, kept warm
After=network-online.target docker.service

[Service]
ExecStart=/walter/context/bin/walter-context-preflight --serve
User=root
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
