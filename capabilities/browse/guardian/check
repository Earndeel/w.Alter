#!/usr/bin/env python3
"""Walter Browse watchdog in Incident v1 (2026-10-28): engines, exits, egress rule (walter-exit-local probe)."""
import json, subprocess, sys, time, urllib.request


def sh(*cmd, timeout=60):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(cmd, 124, "", str(exc))


def active(unit):
    return sh("systemctl", "is-active", unit).stdout.strip() == "active"


def http_json(url, timeout=5):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return json.loads(r.read())
    except Exception as exc:  # noqa: BLE001
        return {"_error": f"{type(exc).__name__}: {str(exc)[:120]}"}


def inc(module, key, kind, severity, summary, evidence=None, level="G0"):
    return {"version": 1, "module": module, "key": key, "kind": kind, "severity": severity, "summary": summary,
            "evidence": evidence or {}, "suggested_level": level}


def units_down(module, units, severity="high"):
    return [inc(module, f"service:{u}", "service_down", severity, f"Le service {u} n'est pas actif.", {"unit": u}, "G1")
            for u in units if not active(u)]


def mac_reachable(host_alias="mac", timeout=5):
    """True when the owner's Mac answers on its ssh port (address read from the ssh config, never hardcoded)."""
    import socket
    cfg = dict(l.split(" ", 1) for l in sh("ssh", "-G", host_alias, timeout=10).stdout.splitlines() if " " in l)
    try:
        socket.create_connection((cfg.get("hostname", host_alias), int(cfg.get("port", 22))), timeout).close()
        return True
    except (OSError, ValueError):
        return False


def engine_probe(unit, port, timeout=30):
    """None when the engine opens a blank tab within `timeout`, else the error.

    An engine at its cgroup MemoryHigh is throttled and swapped, not killed: systemd sees it active and its /health
    answers (it never touches a page) while every real call times out (30/10 and 08/11/2026). So open a real tab in a
    throwaway session, no navigation (no network, no exit), then drop that session."""
    base, user = f"http://127.0.0.1:{port}", "guardian-probe"
    def call(method, path, body=None, t=timeout):
        req = urllib.request.Request(base + path, method=method, data=json.dumps(body).encode() if body else None,
                                     headers={"content-type": "application/json"})
        with urllib.request.urlopen(req, timeout=t) as r:
            return json.loads(r.read() or b"{}")
    t0 = time.time()
    try:
        ok = call("POST", "/tab/new", {"userId": user}).get("ok")
        err = None if ok else "tab/new did not answer ok"
    except Exception as exc:  # noqa: BLE001
        err = f"{type(exc).__name__}: {str(exc)[:120]}"
    try:
        call("DELETE", f"/sessions/{user}", t=5)
    except Exception:  # noqa: BLE001
        pass
    return None if err is None else {"error": err, "seconds": round(time.time() - t0, 1)}


out = units_down("browse", ["camoufox-max", "cloakbrowser-max", "walter-exit-default", "walter-exit-local"])
for unit, port in (("camoufox-max", 9377), ("cloakbrowser-max", 9378)):
    if active(unit):
        bad = engine_probe(unit, port)
        if bad:
            mem = sh("systemctl", "show", unit, "-p", "MemoryCurrent,MemoryHigh,MemorySwapCurrent").stdout.split()
            out.append(inc("browse", f"engine:{unit}", "engine_unresponsive", "high",
                           f"Le navigateur {unit} tourne mais n'ouvre plus d'onglet en 30 s (bloqué).",
                           {"unit": unit, **bad, "memory": mem}, "G1"))
# walter-exit-mac is an ssh tunnel to the owner's Mac. While the Mac sleeps or is offline, systemd restarts it every
# ~25 s, so `is-active` alternates and the incident used to reopen (and re-notify) all night (2026-10-30). A Mac that
# does not answer is expected and already fails closed (exit-local:closed): info, no Telegram. High only when the Mac
# answers but the tunnel stays down.
if not active("walter-exit-mac"):
    if mac_reachable():
        out += units_down("browse", ["walter-exit-mac"])
    else:
        out.append(inc("browse", "exit-mac:mac-offline", "host_offline", "info",
                       "Mac injoignable (veille ou hors ligne) : la sortie réseau via le Mac est suspendue.", {}, "G0"))
r = sh("walter-exit-local", "probe", timeout=120)
try:
    p = json.loads(r.stdout)
    for v in p.get("violations") or []:
        out.append(inc("browse", "egress:" + v[:60], "egress_violation", "critical",
                       f"Règle de sortie réseau enfreinte : {v}.", {"chromium_exit_country": (p.get("chromium_exit") or {}).get("country")}, "G3"))
    loc = p.get("local_exit") or {}
    if loc.get("route") == "closed":
        out.append(inc("browse", "exit-local:closed", "exit_closed", "info",
                       "Sortie locale fermée : Camoufox et les lectures de page sont refusés.", {"why": loc.get("why")}, "G0"))
except ValueError:
    out.append(inc("browse", "egress:probe", "check_failed", "high", "La sonde de sortie réseau ne répond pas.", {"rc": r.returncode}))
print(json.dumps(out, ensure_ascii=False))
