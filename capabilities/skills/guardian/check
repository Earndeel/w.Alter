#!/usr/bin/env python3
"""walter-skills watchdog in Incident v1 (2026-10-28): service, bus consumer and library health only — never the skills' content (the Curator owns it)."""
import json, subprocess, sys, time, urllib.request


def sh(*cmd, timeout=60):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(cmd, 124, "", str(exc))


def active(unit):
    return sh("systemctl", "is-active", unit).stdout.strip() == "active"


def http_json(url, timeout=5):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return json.loads(r.read())
    except Exception as exc:  # noqa: BLE001
        return {"_error": f"{type(exc).__name__}: {str(exc)[:120]}"}


def inc(module, key, kind, severity, summary, evidence=None, level="G0"):
    return {"version": 1, "module": module, "key": key, "kind": kind, "severity": severity, "summary": summary,
            "evidence": evidence or {}, "suggested_level": level}


def units_down(module, units, severity="high"):
    return [inc(module, f"service:{u}", "service_down", severity, f"Le service {u} n'est pas actif.", {"unit": u}, "G1")
            for u in units if not active(u)]


out = units_down("skills", ["walter-skills", "walter-skills-bus"])
h = http_json("http://127.0.0.1:8891/health")
if h.get("_error") or not h.get("ok"):
    out.append(inc("skills", "service:health", "service_unhealthy", "high", "walter-skills :8891 ne répond pas sainement.", h, "G1"))
elif h.get("degraded"):
    out.append(inc("skills", "service:degraded", "service_degraded", "warning", "walter-skills répond en mode dégradé.", h, "G1"))
# Library health beyond the service (nightly freshness, bus consumers, stale cards): taken over on 2026-11-09 from the
# retired Hermes cron "Memory Health Check", which ran `walter-skills health` every 5 min.
r = sh("walter-skills", "health", timeout=60)
try:
    for p in json.loads(r.stdout).get("problems") or []:
        out.append(inc("skills", "health:" + str(p).split(":")[0][:60], "health_problem", "warning",
                       f"walter-skills : {p}.", {"problem": p}))
except ValueError:
    out.append(inc("skills", "health:unavailable", "check_failed", "warning", "walter-skills health ne répond pas.",
                   {"rc": r.returncode}))
print(json.dumps(out, ensure_ascii=False))
