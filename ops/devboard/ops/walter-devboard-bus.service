[Unit]
Description=walter-devboard on the Walter bus: agent turns (Claude Code dev sessions, Codex) mark sessions to read and show live work
After=network-online.target docker.service

[Service]
ExecStart=/usr/local/bin/walter-devboard bus
Restart=on-failure
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
