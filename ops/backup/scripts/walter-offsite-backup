#!/bin/bash
# Walter offsite backup: encrypts (age, the instance's recovery PUBLIC key) and copies off the machine.
# Ported into walter/ops on 2026-10-29 from walter-memory's ops/walter-offsite-backup (2026-10-01, P0.2): same steps,
# same verification and retention; every location comes from the instance (`walter-ops backup env offsite`).
# Kinds (offsite.kinds):
#   pg/        newest local PostgreSQL dump        (walter-pg-backup)
#   statedb/   newest agent-runtime state snapshot (walter-statedb-backup)
#   bitwarden/ vault export, already age-encrypted by Walter Secrets (`walter-secret vault-export`)
#   config/    config bundle of the modules and their integrations (Walter Memory's backup_bundle, fail closed)
#   projects/  the owner's project folders (offsite.projects)                       } folder archives (2026-11-01):
#   user/      the owner's folder (offsite.user), without its local backups and cache   } rebuildable dependencies and
#   apps/      installed apps, their local changes and data (offsite.apps)              } offsite.folder_exclude left out
# Remote retention per kind: keep_daily + keep_weekly (Sunday) + keep_monthly (1st). Upload is hash-verified by rclone.
# Restore: rclone copy "<remote>/<kind>/<file>.age" . && age -d -i <recovery key> <file>.age > <file>
# Without a copy of the PRIVATE recovery key off the machine, these files are unreadable once the machine is gone.
set -euo pipefail
umask 077
eval "$(walter-ops backup env offsite)"
REC="$WALTER_OFFSITE_RECIPIENT"
REMOTE="$WALTER_OFFSITE_REMOTE"
WORK=$(mktemp -d "$WALTER_OFFSITE_WORKDIR/walter-offsite.XXXXXX"); trap 'rm -rf "$WORK"' EXIT
TS=$(date -u +%Y%m%dT%H%M%SZ)
wants() { case " $WALTER_OFFSITE_KINDS " in *" $1 "*) return 0;; *) return 1;; esac; }

push() {  # push <kind> <local file> [remote name]
  local kind=$1 src=$2 name=${3:-$(basename "$2")}
  if rclone lsf "$REMOTE/$kind/" 2>/dev/null | grep -qxF "$name.age"; then echo "skip $kind/$name (already offsite)"; return; fi
  age -R "$REC" -o "$WORK/$name.age" "$src"
  rclone copyto "$WORK/$name.age" "$REMOTE/$kind/$name.age" --drive-chunk-size 64M
  echo "pushed $kind/$name.age ($(du -h "$WORK/$name.age" | cut -f1))"; rm -f "$WORK/$name.age"
}
newest() { ls -1t "$1"/$2 2>/dev/null | head -1 || true; }    # newest <dir> <pattern>

# Unchanged content is not sent again (2026-11-01): the fingerprint of what was last pushed per kind is kept in
# offsite.state_dir; same fingerprint → skipped, and the copy already on Drive stays the newest one.
unchanged() {  # unchanged <kind> <fingerprint>
  [ -n "${WALTER_OFFSITE_STATE:-}" ] && [ "$(cat "$WALTER_OFFSITE_STATE/offsite-$1.sha256" 2>/dev/null)" = "$2" ]
}
remember() {  # remember <kind> <fingerprint>
  [ -n "${WALTER_OFFSITE_STATE:-}" ] || return 0
  mkdir -p "$WALTER_OFFSITE_STATE"; printf '%s\n' "$2" > "$WALTER_OFFSITE_STATE/offsite-$1.sha256"
}

if wants pg; then pg=$(newest "$WALTER_PG_DIR" "$WALTER_PG_PATTERN"); [ -n "$pg" ] && push pg "$pg"; fi
if wants statedb; then sdb=$(newest "$WALTER_STATEDB_DIR" "$WALTER_STATEDB_PATTERN"); [ -n "$sdb" ] && push statedb "$sdb"; fi

# Vault export: encrypted in memory by Walter Secrets (never written in clear), kept locally and offsite. A failed
# export does not stop the rest, but the run exits 1 at the end so the unit shows failed.
BW_FAILED=0
if wants bitwarden; then
  BWDIR="$WALTER_OFFSITE_VAULT_DIR"
  if walter-secret vault-export "$BWDIR/vault-$TS.json.age"   # Walter Secrets interface
  then
    rclone copyto "$BWDIR/vault-$TS.json.age" "$REMOTE/bitwarden/vault-$TS.json.age"   # already age-encrypted
    echo "pushed bitwarden/vault-$TS.json.age ($(du -h "$BWDIR/vault-$TS.json.age" | cut -f1))"
    walter-secret vault-prune >/dev/null
  else
    BW_FAILED=1; echo "WARNING: vault export failed" >&2
  fi
fi

# Fail closed: inventory modules + mutual integrations; verify every archived file (Walter Memory's bundle).
if wants config; then
  walter-python -m walter_memory.backup_bundle create "$WORK/config-$TS.tar"
  # Fingerprint = every archived file's own digest (from the bundle manifest), not the dated manifest itself.
  fp=$(tar -xOf "$WORK/config-$TS.tar" walter-backup-manifest.json | python3 -c \
    'import hashlib,json,sys; print(hashlib.sha256(json.dumps(json.load(sys.stdin)["entries"],sort_keys=True).encode()).hexdigest())')
  if unchanged config "$fp"; then echo "unchanged config (nothing sent)"; rm -f "$WORK/config-$TS.tar"
  else
    zstd -q -T2 -10 --rm "$WORK/config-$TS.tar" -o "$WORK/config-$TS.tar.zst"
    push config "$WORK/config-$TS.tar.zst" && remember config "$fp"
  fi
fi

# Folder archives: sources, git history and data; what a reinstall rebuilds is left out, and so are the paths of
# offsite.folder_exclude. tar exits 1 when a file changes while it is read (a live site writing a log): accepted.
archive_folders() {  # archive_folders <kind> <absolute folders...>
  local -; set -f; local kind=$1; shift; local rel=() ex=()   # no glob expansion of the patterns
  for d in "$@"; do [ -d "$d" ] && rel+=("${d#/}"); done
  [ ${#rel[@]} -gt 0 ] || return 0
  for p in node_modules .venv venv __pycache__ .next .cache .pytest_cache ${WALTER_OFFSITE_FOLDER_EXCLUDE:-}; do
    ex+=("--exclude=${p#/}"); done
  tar -C / -cf "$WORK/$kind-$TS.tar" --sort=name --warning=no-file-changed "${ex[@]}" "${rel[@]}" || [ $? -eq 1 ]
  local fp; fp=$(sha256sum "$WORK/$kind-$TS.tar" | cut -d' ' -f1)
  if unchanged "$kind" "$fp"; then echo "unchanged $kind (nothing sent)"; rm -f "$WORK/$kind-$TS.tar"; return 0; fi
  zstd -q -T2 -10 --rm "$WORK/$kind-$TS.tar" -o "$WORK/$kind-$TS.tar.zst"
  push "$kind" "$WORK/$kind-$TS.tar.zst" && remember "$kind" "$fp"
}
if wants projects && [ -n "${WALTER_OFFSITE_PROJECTS:-}" ]; then archive_folders projects $WALTER_OFFSITE_PROJECTS; fi
if wants user && [ -n "${WALTER_OFFSITE_USER:-}" ]; then archive_folders user $WALTER_OFFSITE_USER; fi
if wants apps && [ -n "${WALTER_OFFSITE_APPS:-}" ]; then archive_folders apps $WALTER_OFFSITE_APPS; fi

# Remote retention
python3 - "$REMOTE" "$WALTER_OFFSITE_KINDS" "$WALTER_OFFSITE_KEEP_DAILY" "$WALTER_OFFSITE_KEEP_WEEKLY" "$WALTER_OFFSITE_KEEP_MONTHLY" <<'PY'
import json, re, subprocess, sys
from datetime import date
remote, kinds = sys.argv[1], sys.argv[2].split()
n_days, n_weeks, n_months = map(int, sys.argv[3:6])
for kind in kinds:
    out = subprocess.run(["rclone", "lsjson", f"{remote}/{kind}/"], capture_output=True, text=True)
    if out.returncode: continue
    files = []
    for f in json.loads(out.stdout or "[]"):
        m = re.search(r"(\d{8})T\d{6}Z", f["Name"])
        if m: files.append((date(int(m[1][:4]), int(m[1][4:6]), int(m[1][6:])), f["Name"]))
    files.sort(reverse=True)
    keep, days, weeks, months = set(), [], [], []
    for d, n in files:
        if d not in days and len(days) < n_days: days.append(d); keep.add(n)
        if d.isoweekday() == 7 and d not in weeks and len(weeks) < n_weeks: weeks.append(d); keep.add(n)
        if (d.year, d.month) not in months and len(months) < n_months: months.append((d.year, d.month)); keep.add(n)
    for d, n in files:
        if n not in keep:
            subprocess.run(["rclone", "deletefile", f"{remote}/{kind}/{n}"], check=False); print("pruned", kind, n)
PY
[ "$BW_FAILED" = 0 ] || { echo "offsite backup done $TS, but the vault export FAILED" >&2; exit 1; }
echo "offsite backup ok $TS"
