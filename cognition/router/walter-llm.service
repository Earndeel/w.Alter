[Unit]
Description=walter-llm — W.Alter model gateway (Walter Router choice + Bitwarden keys) for agent runtimes, 127.0.0.1:8894
After=network-online.target walter-memory-gateway.service

[Service]
ExecStart=/opt/walter-llm/venv/bin/python3 /opt/walter-llm/gateway.py serve
WorkingDirectory=/opt/walter-llm
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
