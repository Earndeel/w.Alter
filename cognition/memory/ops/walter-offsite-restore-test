#!/bin/bash
# SUPERSEDED 2026-10-29: the live copy is walter/ops backup/scripts/walter-offsite-restore-test (the host unit links there).
# Kept unchanged below for rollback only; do not edit here.
# Monthly proof that offsite backups are restorable (Walter Memory P0.2): download the newest of each kind from
# Drive, decrypt with the recovery key, restore PG into a scratch database and compare row counts with live,
# integrity-check state.db, the config bundle and the Bitwarden export (2026-10-16). Scratch data is deleted afterwards.
set -euo pipefail
umask 077
KEY=/root/.hermes/vault/walter-recovery.agekey
REMOTE="gdrive:W.Alter Backups"
WORK=$(mktemp -d /var/tmp/walter-restore.XXXXXX)
cleanup() { rm -rf "$WORK"; docker exec hindsight-pg dropdb -U hindsight --if-exists restore_test_offsite >/dev/null 2>&1 || true; }
trap cleanup EXIT
latest() { rclone lsf "$REMOTE/$1/" | sort | tail -1; }

f=$(latest pg); rclone copyto "$REMOTE/pg/$f" "$WORK/$f"; age -d -i "$KEY" -o "$WORK/pg.dump" "$WORK/$f"
docker exec hindsight-pg dropdb -U hindsight --if-exists restore_test_offsite
docker exec hindsight-pg createdb -U hindsight restore_test_offsite
docker exec -i hindsight-pg pg_restore -U hindsight -d restore_test_offsite --no-owner < "$WORK/pg.dump"
q="select (select count(*) from memory_units)||'/'||(select count(*) from documents)||'/'||(select count(*) from kardex.messages)"
live=$(docker exec hindsight-pg psql -U hindsight -d hindsight -Atc "$q"); rest=$(docker exec hindsight-pg psql -U hindsight -d restore_test_offsite -Atc "$q")
echo "pg $f: restored units/docs/kardex_msgs=$rest live=$live"

# Verify the current durable schemas, including the raw logs and each module registry.
docker exec hindsight-pg psql -v ON_ERROR_STOP=1 -U hindsight -d restore_test_offsite -Atc "select json_build_object('core_events',(select count(*) from core.events),'raw_log_events',(select count(*) from walter_logs.events),'objects',(select count(*) from core.objects),'skills',(select count(*) from skills.catalog),'model_tasks',(select count(*) from models.tasks))"


f=$(latest statedb); rclone copyto "$REMOTE/statedb/$f" "$WORK/$f"; age -d -i "$KEY" "$WORK/$f" | zstd -q -d -o "$WORK/state.db"
python3 - "$WORK/state.db" <<'PY'
import sqlite3, sys
c = sqlite3.connect(sys.argv[1]); ok = c.execute("pragma quick_check").fetchone()[0]
print(f"statedb: quick_check={ok} sessions={c.execute('select count(*) from sessions').fetchone()[0]} messages={c.execute('select count(*) from messages').fetchone()[0]}")
if ok != "ok": sys.exit(1)
PY
f=$(latest config); rclone copyto "$REMOTE/config/$f" "$WORK/$f"
echo "config $f: checking module + integration coverage and all checksums"
age -d -i "$KEY" "$WORK/$f" | zstd -q -d | walter-python -m walter_memory.backup_bundle verify - --check-current
f=$(latest bitwarden); rclone copyto "$REMOTE/bitwarden/$f" "$WORK/$f"
age -d -i "$KEY" "$WORK/$f" | python3 -c 'import sys,json; n=len(json.load(sys.stdin)["items"]); print(f"bitwarden '"$f"': {n} items"); sys.exit(0 if n >= 100 else 1)'
echo "offsite restore test OK"
