{
  "id": "memory",
  "decisions": "manifest/decisions.json",
  "anchors": [
    "contracts/memory.json",
    "walter_memory/events.py",
    "walter_memory/objects.py",
    "walter_memory/client.py",
    "walter_memory/read_policy.py",
    "walter_memory/overland.py"
  ],
  "requires": [
    "core"
  ],
  "external": [
    "PostgreSQL walter-pg:5433",
    "pgvector",
    "walter-llm for derived extraction",
    "Beeper Server through core public BeeperClient (no Mac dependency)"
  ],
  "data": [
    "core.*",
    "ingestion.*",
    "privacy.*",
    "search.*",
    "system.*",
    "kardex.*",
    "extraction.*",
    "processing.*"
  ],
  "core_paths": [
    "walter_memory/events.py",
    "walter_memory/objects.py"
  ],
  "backup_paths": [
    ".",
    "/root/.pgpass",
    "@instance/bootstrap/overland.env"
  ],
  "interfaces": [
    "Python library",
    "HTTP :8890",
    "CLI",
    "MCP",
    "Overland authenticated HTTP :3010",
    "CLI runs find [RUN_ID|--session SESSION] --open-only: unique open-run metadata run_id/status/privacy_class, ambiguity refused; runs routing RUN_ID: JSONstdin allowlist applied/via/model_id/model/provider/observed_model; runs end RUN_ID: explicit ended/failed/cancelled status, idempotent canonical writer",
    "HTTP :8890 socle A3/A4: POST /v1/tasks/list {thread_id?, session_id?, status?, limit} -> {tasks: [{task_id, goal, status, thread_id, updated_at, progress, attempts, last_outcome}]}; POST /v1/tasks/update {task_id, status?, progress?, result?, note?}; POST /v1/experience {thread_id?, query?, limit} -> {items: [{at, run_id, status, summary, errors, lessons, solutions, pending}]}; /v1/runs/end accepts outcome; /v1/runs/start origin accepts interface, engine_session, request_id; /v1/context accepts thread_id (layers tasks, experience)",
    "CLI tasks list|show|update|sweep|triage-redecide [--execute] [--channels owner|all|a,b]; CLI experience [--thread] [--query]",
    "Beeper connector: WS -> ingestion.jobs beeper_events -> canonical core.events/media/bus; profile-scoped cursors in existing checkpoints"
  ],
  "bindings": {
    "dsh": "common MCP",
    "codex": "common MCP",
    "claude-code": "common MCP",
    "voice": "Authenticated canonical gateway through voice-memory HTTP port"
  },
  "limitations": [
    "Canonical reads exclude stale, retracted, private and unprovenanced legacy cognitive rows.",
    "Wild profile reads are refused by the cloud-safe port; local-only history remains local.",
    "Existing desktop provider instances change on next session initialization; not force-restarted."
  ],
  "services": [
    "walter-memory-gateway",
    "walter-memory-overland",
    "walter-memory-pipeline",
    "walter-memory-beeper-watch.service",
    "walter-memory-beeper.timer"
  ],
  "optional": [
    "llm"
  ],
  "contract": {
    "schema_version": 1,
    "version": "1.2.0",
    "owner": "memory",
    "kind": "capability",
    "purpose": "Posséder les événements et objets canoniques, leur provenance et les connaissances dérivées.",
    "target_root": "cognition/memory",
    "config_paths": [
      ".env"
    ],
    "permissions": [
      "classification de confidentialité",
      "budget des traitements modèle"
    ],
    "invariants": [
      "Les adaptateurs réutilisent le noyau commun et conservent les permissions du harness.",
      "Une indisponibilité est explicite ; aucun repli concurrent non déclaré.",
      "Les données privées et secrets ne sont pas exposés par les diagnostics."
    ],
    "errors": [
      "invalid_request",
      "permission_denied",
      "dependency_unavailable",
      "deadline_exceeded",
      "internal_error"
    ],
    "cancellation": [
      "Propager l’annulation lorsque le port la supporte ; qualifier le comportement par interface.",
      "Une interruption ne doit pas être présentée comme une annulation transactionnelle garantie."
    ],
    "operations": [
      {
        "id": "primary",
        "transport": "mcp",
        "interface": "memory_recall",
        "access": "read",
        "timeout_seconds": 60,
        "timeout_status": "target"
      },
      {
        "id": "retain",
        "transport": "mcp",
        "interface": "memory_retain",
        "access": "write",
        "timeout_seconds": 60,
        "timeout_status": "target"
      },
      {
        "id": "reflect",
        "transport": "mcp",
        "interface": "memory_reflect",
        "access": "execute",
        "timeout_seconds": 60,
        "timeout_status": "target"
      }
    ],
    "resources": [
      {
        "id": "postgres:core",
        "role": "owner",
        "owner": "memory",
        "durability": "canonical"
      },
      {
        "id": "postgres:ingestion",
        "role": "owner",
        "owner": "memory",
        "durability": "configuration"
      },
      {
        "id": "postgres:privacy",
        "role": "owner",
        "owner": "memory",
        "durability": "configuration"
      },
      {
        "id": "postgres:search",
        "role": "owner",
        "owner": "memory",
        "durability": "projection"
      },
      {
        "id": "postgres:system",
        "role": "owner",
        "owner": "memory",
        "durability": "configuration"
      },
      {
        "id": "postgres:kardex",
        "role": "owner",
        "owner": "memory",
        "durability": "projection"
      },
      {
        "id": "embedding-models",
        "role": "owner",
        "owner": "memory",
        "durability": "projection"
      }
    ],
    "migrations": [
      "Versionner le contrat et vérifier les adaptateurs consommateurs avant activation.",
      "Sauvegarder les données avant migration ; documenter la compatibilité du retour arrière."
    ],
    "recovery": {
      "backup": [
        "Utiliser backup_paths et anchors de ce manifeste ; inclure les configurations des ports.",
        "Les schémas PostgreSQL sont sauvegardés par dump cohérent, les SQLite par snapshot."
      ],
      "restore": [
        "Restaurer ensemble le module, ses configurations, ses données et les versions des ports.",
        "Rétablir les accès externes depuis le matériel de récupération protégé."
      ],
      "verification": [
        "Vérifier empreintes, modes, liens et dépendances.",
        "Rejouer les scénarios du module et les intégrations ; l’archive seule ne prouve pas la restauration."
      ]
    },
    "acceptance": [
      {
        "id": "privacy-provenance",
        "assertion": "Les lectures refusent les sources privées, purgées ou rétractées et les fragments périmés.",
        "scope": "integration"
      },
      {
        "id": "temporal-decisions",
        "assertion": "Les décisions datées et remplacées ne sont pas présentées comme des instructions actuelles.",
        "scope": "live"
      },
      {
        "id": "restore",
        "assertion": "Le module et ses données sont reconstruits dans un environnement isolé avec ses intégrations.",
        "scope": "recovery"
      }
    ],
    "conventions_status": "required; enforced per port only after qualification evidence"
  },
  "presentation": {
    "audience": "agent",
    "title": "Walter Memory",
    "order": 10,
    "summary": "manifest/SUMMARY.md",
    "manifest": "manifest/MANIFEST.md",
    "guide": "manifest/GUIDE.md",
    "tools": [
      "memory_context",
      "memory_search",
      "memory_events",
      "person_lookup",
      "memory_retain",
      "memory_recall",
      "memory_reflect",
      "memory_view",
      "tasks_list",
      "task_create",
      "task_update"
    ],
    "capabilities": {
      "memory_context": {
        "effects": [
          "none"
        ],
        "concurrency": "parallel",
        "produces": [
          "entity",
          "view"
        ],
        "returns": {
          "type": "string"
        }
      },
      "memory_search": {
        "effects": [
          "none"
        ],
        "concurrency": "parallel",
        "produces": [
          "event",
          "derived",
          "object"
        ],
        "returns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "ref_id": {
                "type": "string"
              },
              "typed_ref": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "occurred_at": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          }
        }
      },
      "memory_events": {
        "effects": [
          "none"
        ],
        "concurrency": "parallel",
        "consumes": [
          "event",
          "thread"
        ],
        "produces": [
          "event",
          "thread",
          "object"
        ],
        "returns": {
          "type": "object",
          "properties": {
            "events": {
              "type": "array"
            },
            "truncated": {
              "type": "integer"
            },
            "next": {
              "type": "object"
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "person_lookup": {
        "effects": [
          "none"
        ],
        "concurrency": "parallel",
        "produces": [
          "entity",
          "thread"
        ],
        "returns": {
          "type": "object",
          "properties": {
            "entity_id": {
              "type": "string"
            }
          }
        }
      },
      "memory_retain": {
        "effects": [
          "record"
        ],
        "concurrency": "parallel",
        "idempotency": "natural",
        "produces": [
          "event"
        ],
        "returns": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            }
          }
        }
      },
      "memory_recall": {
        "effects": [
          "none"
        ],
        "concurrency": "parallel",
        "produces": [
          "event",
          "derived"
        ],
        "returns": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            }
          }
        }
      },
      "memory_reflect": {
        "effects": [
          "cost"
        ],
        "concurrency": "parallel",
        "produces": [
          "event",
          "derived"
        ],
        "returns": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            }
          }
        }
      },
      "memory_view": {
        "effects": [
          "none"
        ],
        "concurrency": "parallel",
        "consumes": [
          "derived",
          "view",
          "entity"
        ],
        "produces": [
          "event",
          "derived",
          "view"
        ],
        "returns": {
          "type": "string"
        }
      },
      "tasks_list": {
        "effects": [
          "none"
        ],
        "concurrency": "parallel",
        "consumes": [
          "thread"
        ],
        "produces": [
          "task",
          "entity",
          "thread"
        ],
        "returns": {
          "type": "object",
          "properties": {
            "tasks": {
              "type": "array"
            }
          }
        }
      },
      "task_create": {
        "effects": [
          "record"
        ],
        "concurrency": "parallel",
        "consumes": [
          "entity"
        ],
        "produces": [
          "task"
        ],
        "idempotency": "natural",
        "returns": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "verified": {
              "type": "boolean"
            }
          }
        }
      },
      "task_update": {
        "effects": [
          "record"
        ],
        "concurrency": {
          "resource": "memory-task",
          "key": "task_id"
        },
        "consumes": [
          "task"
        ],
        "idempotency": "natural",
        "returns": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "components": [
    {
      "id": "events",
      "path": "walter_memory/events.py",
      "role": "Canonical journal core.events (append-only, idempotent)",
      "status": "active",
      "readme": "README.md",
      "data": [
        "postgres:core"
      ],
      "vision_target": "cognition/memory"
    },
    {
      "id": "media",
      "path": "walter_memory/media.py",
      "role": "Derivation of Raw Vault media: audio → transcript (stt poste), document → local extraction, image → OCR/caption (vision poste, disabled); driven by the bus (memory.object)",
      "status": "active",
      "readme": "README.md",
      "data": [
        "postgres:core",
        "postgres:processing"
      ],
      "vision_target": "cognition/memory"
    },
    {
      "id": "gateway",
      "path": "walter_memory/gateway.py",
      "role": "The only write door (127.0.0.1:8890)",
      "status": "active",
      "readme": "README.md",
      "interfaces": [
        {
          "transport": "http",
          "interface": "127.0.0.1:8890/v1"
        }
      ],
      "vision_target": "cognition/memory"
    },
    {
      "id": "connectors",
      "path": "connectors",
      "role": "Connectors (beeper, gmail, calendar, agent_sessions, triage…)",
      "status": "active",
      "readme": "README.md",
      "vision_target": "cognition/memory/connectors"
    },
    {
      "id": "organic",
      "path": "walter_memory/organic.py",
      "role": "Organic memory V1 (views, episodes, periods, flows)",
      "status": "active",
      "readme": "README.md",
      "vision_target": "cognition/memory"
    },
    {
      "id": "assimilation",
      "path": "walter_memory/assimilation.py",
      "role": "Bus-driven assimilation (memory.organic)",
      "status": "active",
      "readme": "README.md",
      "vision_target": "cognition/memory"
    },
    {
      "id": "runs",
      "path": "walter_memory/runs.py",
      "role": "Run plane: runs, delegated tasks and the owner's durable tasks, run episodes and experience",
      "status": "active",
      "readme": "README.md",
      "data": [
        "postgres:runs"
      ],
      "vision_target": "core/orchestration"
    },
    {
      "id": "kardex",
      "path": "walter_memory/social.py",
      "role": "Kardex social layer (schema kardex)",
      "status": "active",
      "readme": "README.md",
      "data": [
        "postgres:kardex"
      ],
      "vision_target": "cognition/memory/kardex"
    },
    {
      "id": "search",
      "path": "walter_memory/search.py",
      "role": "Search index (search.chunks)",
      "status": "active",
      "readme": "README.md",
      "vision_target": "cognition/memory"
    },
    {
      "id": "privacy",
      "path": "walter_memory/privacy.py",
      "role": "Privacy classes and reading rule",
      "status": "active",
      "readme": "README.md",
      "vision_target": "cognition/memory"
    },
    {
      "id": "disclosure",
      "path": "walter_memory/disclosure.py",
      "role": "Disclosure check of outgoing messages",
      "status": "active",
      "readme": "README.md",
      "vision_target": "core/security"
    },
    {
      "id": "llm-client",
      "path": "walter_memory/llm.py",
      "role": "Memory's model calls (refuses local_only, budgets); keys through Walter Secrets grants, no file fallback",
      "status": "active",
      "readme": "README.md",
      "vision_target": "cognition/memory"
    },
    {
      "id": "migrations",
      "path": "migrations",
      "role": "PostgreSQL migrations",
      "status": "active",
      "readme": "README.md",
      "vision_target": "cognition/memory/migrations"
    },
    {
      "id": "overland",
      "path": "walter_memory/overland.py",
      "role": "GPS reception (Overland, :3010)",
      "status": "active",
      "readme": "README.md",
      "interfaces": [
        {
          "transport": "http",
          "interface": "127.0.0.1:3010"
        }
      ],
      "vision_target": "cognition/memory/connectors"
    },
    {
      "id": "beeper-native",
      "path": "connectors/beeper_watch.py",
      "role": "Event-driven Beeper ingestion; HTTP catch-up and canonical deduplication",
      "status": "implemented",
      "readme": "README.md",
      "vision_target": "cognition/memory/connectors",
      "data": [
        "postgres:core",
        "postgres:ingestion"
      ]
    }
  ]
}
