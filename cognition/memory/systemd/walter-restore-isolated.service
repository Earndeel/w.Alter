[Unit]
Description=Walter: isolated offsite reconstruction rehearsal (networkless disposable PG, no restored consumers)
After=network-online.target docker.service
Wants=docker.service

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=/walter/cognition/memory
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/walter-python -m walter_memory.restore_drill --report /user/Lucas/logs/walter-restore-isolated/latest.json
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
